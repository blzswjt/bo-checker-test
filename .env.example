# ============================================================
# 数据建模识别智能体 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# 默认使用的模型ID (doubao-turbo / doubao / deepseek-flash / deepseek-pro / qwen)
DEFAULT_MODEL=doubao-turbo

# 豆包 Turbo (快速) - 推荐日常使用
DOUBAO_TURBO_MODEL=your-endpoint-id

# 豆包 Evolving (推理) - 深度推理，较慢
DOUBAO_MODEL=doubao-seed-evolving

# DeepSeek V4
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash-260425
DEEPSEEK_PRO_MODEL=deepseek-v4-pro-260425

# 豆包/DeepSeek 共用配置 - 火山引擎方舟
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-api-key

# 通义千问 (Qwen) - DashScope
QWEN_MODEL=qwen-plus-latest
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-api-key

# 服务端口
PORT=8005

# ============ 视觉模型（图片识别） ============
# 默认视觉模型：qwen-vl 或 doubao-vision
DEFAULT_VISION_MODEL=qwen-vl
# 豆包视觉模型
VISION_DOUBAO_MODEL=doubao-1-5-vision-pro/250328
# 通义千问视觉模型
VISION_QWEN_MODEL=qwen-vl-max
