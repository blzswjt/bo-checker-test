# ============================================================
# 数据建模识别智能体 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# 默认使用的模型ID (deepseek-flash / deepseek-pro / doubao-turbo / doubao / qwen)
DEFAULT_MODEL=deepseek-flash

# DeepSeek V4 - 直连官网 (https://platform.deepseek.com)
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# 豆包 Turbo (快速)
DOUBAO_TURBO_MODEL=your-endpoint-id

# 豆包 Evolving (推理)
DOUBAO_MODEL=doubao-seed-evolving

# 豆包配置 - 火山引擎方舟
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-api-key

# 通义千问 (Qwen) - DashScope
QWEN_MODEL=qwen-plus-latest
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-api-key

# 服务端口
PORT=8005

# ============ 视觉模型（图片识别） ============
# 默认视觉模型：qwen-vl 或 doubao-vision
DEFAULT_VISION_MODEL=qwen-vl
# 豆包视觉模型
VISION_DOUBAO_MODEL=doubao-1-5-vision-pro/250328
# 通义千问视觉模型
VISION_QWEN_MODEL=qwen-vl-max
